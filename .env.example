# Provider: auto | openai | openrouter | cursor
# auto picks openrouter > cursor > openai based on which keys are set
LLM_PROVIDER=auto

# --- OpenAI ---
OPENAI_API_KEY=

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=agentic-company

# --- Cursor ---
# CURSOR_API_KEY alone is not a chat-completions API (Cloud Agents only).
# Point CURSOR_BASE_URL at an OpenAI-compatible gateway that uses your Cursor key,
# e.g. http://127.0.0.1:8787/v1
CURSOR_API_KEY=
CURSOR_BASE_URL=

# Models (provider-specific defaults apply if you leave openai:* while on openrouter/cursor)
PLANNER_MODEL=openai:gpt-4.1-mini
CRITIC_MODEL=openai:gpt-4.1-mini
SPECIALIST_MODEL=openai:gpt-4.1-mini
BUILDER_MODEL=openai:gpt-4.1
# OpenRouter examples:
# PLANNER_MODEL=openai/gpt-4o-mini
# BUILDER_MODEL=anthropic/claude-sonnet-4.5

# Builder: native | deepagents
BUILDER_BACKEND=native

# Paths (relative to project root unless absolute)
RUNS_DIR=runs
MAX_BUILDER_RETRIES=3
BUILDER_MAX_TURNS=25
TEST_TIMEOUT_SECONDS=60

# Memory: local (Chroma under runs/memory) | remote (set MEMORY_REMOTE_URL)
MEMORY_BACKEND=local
MEMORY_REMOTE_URL=
MEMORY_TOP_K=3

# GitHub Issues (private repos / PRs / higher rate limits)
# Required for: cloning private repos, pushing branches, opening PRs
GITHUB_TOKEN=
GIT_AUTHOR_NAME=agentic-company
GIT_AUTHOR_EMAIL=agentic-company@users.noreply.github.com

# LinkedIn Share on LinkedIn (UGC Posts)
# Docs: https://learn.microsoft.com/en-gb/linkedin/consumer/integrations/self-serve/share-on-linkedin
# Create a LinkedIn app, add the "Share on LinkedIn" product, request w_member_social,
# then set a member access token here. Posts pause for human approve (+ optional image).
LINKEDIN_ACCESS_TOKEN=
# Optional: skip /userinfo lookup (urn:li:person:XXXX or just XXXX)
LINKEDIN_PERSON_URN=
# PUBLIC | CONNECTIONS
LINKEDIN_VISIBILITY=PUBLIC

# Web
WEB_HOST=127.0.0.1
WEB_PORT=8000
